# Copy to .env (or export these directly) before running the app.
# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/booking_db
DB_USERNAME=booking_user
DB_PASSWORD=booking_password

# JWT — generate a real random 32+ byte value for anything beyond local testing, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-this-super-secret-key-before-deploying-to-anything-real
JWT_EXPIRATION_MS=3600000

# App
SERVER_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
